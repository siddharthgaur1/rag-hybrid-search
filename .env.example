# OpenAI (or any OpenAI-compatible provider)
OPENAI_API_KEY=sk-...
# Base URL. Empty = OpenAI. For a fully-free/offline run point it at a local Ollama,
# which serves both embeddings and chat — then set the model names to local ones:
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   EMBEDDING_MODEL=nomic-embed-text  GENERATION_MODEL=llama3.2  JUDGE_MODEL=llama3.2
OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
GENERATION_MODEL=gpt-4o
JUDGE_MODEL=gpt-4o

# Retrieval
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3
RRF_K=60
FUSION_TOP_K=20
RERANK_TOP_K=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Chunking
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
SEMANTIC_SIMILARITY_THRESHOLD=0.7
DEDUP_SIMILARITY_THRESHOLD=0.95
DEFAULT_CHUNKING_STRATEGY=structure_aware

# Storage
CHROMA_DB_PATH=data/chroma_db
BM25_INDEX_PATH=data/bm25_index
DOCS_PATH=docs

# Alerting (shared with llm-regression-detector)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# API
API_HOST=0.0.0.0
API_PORT=8000
