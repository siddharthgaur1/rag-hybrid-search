# --- API service ---
OPENAI_API_KEY=            # Required - OpenAI API key
CHROMA_DB_PATH=/app/data/chroma_db   # Optional - override if using a Railway volume mount other than /app/data
BM25_INDEX_PATH=/app/data/bm25_index # Optional - same as above
PORT=                       # Set automatically by Railway - do not set manually

# --- Dashboard service ---
API_BASE_URL=               # Required on the dashboard service - public URL of the API service
